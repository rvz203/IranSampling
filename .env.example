# Docker Compose database password. Use a long URL-safe value in production.
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgres://sampling:replace_with_a_long_random_password@127.0.0.1:5432/sampling?sslmode=disable
API_PORT=8080
API_URL=http://127.0.0.1:8080
APP_ENV=development
ENABLE_DEMO=true
UPLOAD_DIR=uploads
# Host folder containing iran.pmtiles and assets/ for Docker Compose.
MAP_DATA_HOST_DIR=./.local/maps
# When running Go directly, MAP_DATA_DIR defaults to ../.local/maps from backend/.
# For an empty production database, set both to bootstrap the first administrator.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use_a_unique_password_of_at_least_12_characters
